# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de La Cuchilla
#
# Copiá este archivo a .env.local para desarrollo. Los valores de acá son
# FICTICIOS: no sirven para conectarse a nada. Los reales se cargan en Vercel,
# en Settings → Environment Variables, y nunca se suben al repositorio.
#
# Ninguna lleva el prefijo NEXT_PUBLIC_, así que Next no las expone al
# navegador.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (Neon). Usá la cadena "pooled" que da Neon.
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/basededatos?sslmode=require

# Acceso al panel de administración.
# admin/admin es TEMPORAL, solo para la demo: cambialo antes de abrir la web.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secreto para firmar la cookie de sesión. Generá uno largo y propio:
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# Vercel Blob. Solo para desarrollo local: en Vercel la subida se autentica con
# OIDC y alcanza con BLOB_STORE_ID, que la plataforma inyecta sola.
# Los stores nuevos no emiten este token; se saca del panel del store si hace
# falta probar la subida en local.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_TOKEN_FICTICIO

# Correo al cliente. Todavía no hay proveedor conectado: sin esta variable no
# se envía nada y el pedido funciona igual. "consola" escribe el mensaje en los
# registros del servidor, para poder revisarlo sin dar de alta ningún servicio.
# Ver docs/emails.md.
EMAIL_PROVEEDOR=

# URL pública del sitio, para los enlaces del correo. En Vercel se deduce sola.
SITIO_URL=
